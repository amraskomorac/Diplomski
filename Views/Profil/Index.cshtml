@model Diplomski.Models.ProfilViewModel

<form asp-action="Index" method="post" class="container mt-5" style="max-width:420px">
    <h3>Profil korisnika</h3>

    @if (ViewBag.Poruka != null)
    {
        <div class="alert alert-success">@ViewBag.Poruka</div>
    }

    <input asp-for="PunoIme" class="form-control mb-2" />
    <input asp-for="Email" class="form-control mb-2" />

    <button class="btn btn-primary w-100">Sačuvaj promjene</button>
    <a asp-action="PromjenaLozinke" class="d-block mt-3">Promjena lozinke</a>
    <a asp-controller="Auth" asp-action="Odjava" class="d-block mt-2">Odjava</a>
</form>