@model Diplomski.Models.ProfilViewModel
@{
    ViewData["Title"] = "Profil";
}

<div class="container py-5" style="max-width: 650px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Profil korisnika</h2>
            <p class="text-muted mb-0">Upravljajte svojim podacima.</p>
        </div>
        <span class="fs-2 text-primary" aria-hidden="true"><i class="bi bi-person-circle"></i></span>
    </div>

    @if (TempData["Poruka"] is not null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Poruka"]</span>
        </div>
    }

    <form asp-action="Index" method="post" class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h5 class="card-title mb-4">Osnovni podaci</h5>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="PunoIme" class="form-label">Puno ime</label>
                @if (Model.UrediProfil) { <input asp-for="PunoIme" class="form-control" autocomplete="name" /> }
                else { <input asp-for="PunoIme" class="form-control profil-polje-samo-za-citanje" autocomplete="name" readonly /> }
            </div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label">E-mail adresa</label>
                @if (Model.UrediProfil) { <input asp-for="Email" type="email" class="form-control" autocomplete="email" /> }
                else { <input asp-for="Email" type="email" class="form-control profil-polje-samo-za-citanje" autocomplete="email" readonly /> }
            </div>

            <div class="profil-tema border-top pt-4 mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h6 class="mb-1">Izgled aplikacije</h6>
                        <p class="text-muted small mb-0">Odaberite svijetli ili tamni način rada.</p>
                    </div>
                    <button type="button" id="temaDugme" class="btn btn-outline-primary" aria-pressed="false">
                        <i class="bi bi-moon-stars me-1"></i><span>Uključi tamni način rada</span>
                    </button>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-between align-items-sm-center border-top pt-4">
                <a asp-action="PromjenaLozinke" class="btn btn-outline-primary">
                    <i class="bi bi-shield-lock me-1"></i> Promijeni lozinku
                </a>
                @if (Model.UrediProfil)
                {
                    <div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Odustani</a><button type="submit" class="btn btn-primary">Sačuvaj promjene</button></div>
                }
                else
                {
                    <a asp-action="Index" asp-route-uredi="true" class="btn btn-primary">Uredi profil</a>
                }
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const dugme = document.getElementById('temaDugme');
            const azurirajDugme = function () {
                const tamniRezim = document.documentElement.classList.contains('tamni-rezim');
                dugme.setAttribute('aria-pressed', tamniRezim);
                dugme.innerHTML = tamniRezim
                    ? '<i class="bi bi-sun me-1"></i><span>Uključi svijetli način rada</span>'
                    : '<i class="bi bi-moon-stars me-1"></i><span>Uključi tamni način rada</span>';
            };

            azurirajDugme();
            dugme.addEventListener('click', function () {
                const tamniRezim = document.documentElement.classList.toggle('tamni-rezim');
                localStorage.setItem('tema-prikaza', tamniRezim ? 'tamna' : 'svijetla');
                azurirajDugme();
            });
        });
    </script>
}
