@model IEnumerable<Diplomski.Models.Trosak>
@{
    ViewData["Title"] = "Troškovi";
}

<div class="container py-5" style="max-width: 850px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="mb-1">Troškovi</h2><p class="text-muted mb-0">Vaši evidentirani troškovi.</p></div>
        <a asp-action="Dodaj" class="btn btn-primary">+ Dodaj trošak</a>
    </div>
    @if (TempData["Poruka"] != null) { <div class="alert alert-success">@TempData["Poruka"]</div> }
    @if (Model.Any())
    {
        <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Vozilo</th><th>Tip troška</th><th>Datum</th><th class="text-end">Iznos</th><th></th></tr></thead><tbody>
        @foreach (var trosak in Model) { <tr><td>@(trosak.Vozilo is null ? "Nije odabrano" : $"{trosak.Vozilo.Marka} {trosak.Vozilo.Model}")</td><td>@trosak.Tip</td><td>@trosak.Datum.ToString("dd.MM.yyyy.")</td><td class="text-end">@trosak.Iznos.ToString("N2") KM</td><td><div class="d-flex justify-content-end gap-2"><a asp-action="Uredi" asp-route-id="@trosak.Id" class="btn btn-outline-primary btn-sm" title="Uredi trošak" aria-label="Uredi trošak"><i class="bi bi-pencil-square"></i></a><form asp-action="Obrisi" asp-route-id="@trosak.Id" method="post"><button type="submit" class="btn btn-outline-danger btn-sm" title="Obriši trošak" aria-label="Obriši trošak" onclick="return confirm('Da li želite obrisati trošak?');"><i class="bi bi-trash3"></i></button></form></div></td></tr> }
        </tbody></table></div></div>
    }
    else { <div class="alert alert-light border">Još nemate evidentiranih troškova.</div> }
</div>
