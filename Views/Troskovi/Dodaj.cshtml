@model Diplomski.Models.Trosak
@{
    ViewData["Title"] = "Dodaj trošak";
}

<div class="container py-5" style="max-width: 650px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="mb-1">Dodaj trošak</h2><p class="text-muted mb-0">Zabilježite novi trošak.</p></div>
        <a asp-action="Index" class="btn btn-outline-secondary">Svi troškovi</a>
    </div>
    <form asp-action="Dodaj" method="post" class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="VoziloId" class="form-label">Vozilo</label>
                <select asp-for="VoziloId" asp-items="ViewBag.Vozila" class="form-select">
                    <option value="">Odaberite vozilo</option>
                </select>
                <span asp-validation-for="VoziloId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Tip" class="form-label">Tip troška</label>
                <input asp-for="Tip" class="form-control" placeholder="npr. Zamjena ulja" />
                <span asp-validation-for="Tip" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Iznos" class="form-label">Iznos (KM)</label>
                <input asp-for="Iznos" type="number" min="0.01" step="0.01" class="form-control" />
                <span asp-validation-for="Iznos" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Datum" class="form-label">Datum troška</label>
                <input asp-for="Datum" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                <span asp-validation-for="Datum" class="text-danger"></span>
            </div>
            <button class="btn btn-primary">Sačuvaj trošak</button>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
