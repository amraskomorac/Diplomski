@model Diplomski.Models.ZaboravljenaLozinkaViewModel

<form asp-action="ZaboravljenaLozinka" method="post" class="container mt-5" style="max-width:420px">
    <h3>Zaboravljena lozinka</h3>

    <input asp-for="Email" class="form-control mb-2" placeholder="Unesite email" />
    <button class="btn btn-primary w-100">Pošalji link</button>

    @if (ViewBag.ResetLink != null)
    {
        <div class="alert alert-info mt-3">
            Test link: <a href="@ViewBag.ResetLink">@ViewBag.ResetLink</a>
        </div>
    }
</form>