@model Diplomski.Models.Servis
@{
    var tipoviServisa = new[]
    {
        "Mali servis", "Veliki servis", "Zamjena ulja", "Filter ulja", "Filter zraka", "Filter kabine",
        "Filter goriva", "Svjećice", "Zupčasti remen", "Lanac", "Rashladna tečnost", "Kočiona tečnost",
        "Diskovi", "Pločice", "Gume", "Akumulator"
    };
    var danas = DateTime.Today.ToString("yyyy-MM-dd");
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-6">
        @if (ViewBag.OdabranoVoziloNaziv is string nazivVozila)
        {
            <label class="form-label">Vozilo</label>
            <input asp-for="VoziloId" type="hidden" />
            <div class="form-control bg-light">@nazivVozila</div>
        }
        else
        {
            <label asp-for="VoziloId" class="form-label">Vozilo</label>
            <select asp-for="VoziloId" asp-items="ViewBag.Vozila" class="form-select">
                <option value="">Odaberite vozilo</option>
            </select>
            <span asp-validation-for="VoziloId" class="text-danger"></span>
        }
    </div>

    <div class="col-md-6">
        <label asp-for="Tip" class="form-label">Vrsta servisa</label>
        <select asp-for="Tip" class="form-select">
            <option value="">Odaberite vrstu servisa</option>
            @foreach (var tip in tipoviServisa)
            {
                <option value="@tip">@tip</option>
            }
        </select>
        <span asp-validation-for="Tip" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Datum" class="form-label">Datum servisa</label>
        <input asp-for="Datum" type="date" max="@danas" class="form-control" />
        <span asp-validation-for="Datum" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Kilometraza" class="form-label">Kilometraža</label>
        <input asp-for="Kilometraza" type="number" min="0" class="form-control" />
        <span asp-validation-for="Kilometraza" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Cijena" class="form-label">Cijena (KM)</label>
        <input asp-for="Cijena" type="number" min="0.01" step="0.01" class="form-control" />
        <span asp-validation-for="Cijena" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Serviser" class="form-label">Serviser</label>
        <input asp-for="Serviser" class="form-control" placeholder="Naziv servisa ili ime servisera" />
        <span asp-validation-for="Serviser" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label for="racunDatoteka" class="form-label">Račun</label>
        <input id="racunDatoteka" name="racunDatoteka" type="file" accept=".jpg,.jpeg,.png,.pdf" class="form-control" />
        <div class="form-text">Dozvoljeni formati: JPG, PNG ili PDF. Maksimalna veličina: 5 MB.</div>
        @if (!string.IsNullOrWhiteSpace(Model.PutanjaRacuna))
        {
            <a href="@Model.PutanjaRacuna" target="_blank" class="d-inline-block mt-2 small"><i class="bi bi-receipt me-1"></i>Pregled trenutnog računa</a>
        }
    </div>

    <div class="col-12">
        <label asp-for="Napomena" class="form-label">Obavljeni radovi i napomena</label>
        <textarea asp-for="Napomena" class="form-control" rows="4" placeholder="npr. Zamjena motornog ulja, filtera i kontrola kocnica"></textarea>
        <span asp-validation-for="Napomena" class="text-danger"></span>
    </div>
</div>
