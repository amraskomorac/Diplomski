@model Diplomski.Models.Servis
@{
    ViewData["Title"] = "Uredi servis";
}

<div class="container py-5" style="max-width: 850px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Uredi servis</h2>
            <p class="text-muted mb-0">Izmijenite evidentirane podatke o servisu.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Svi servisi</a>
    </div>

    <form asp-action="Uredi" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card shadow-sm border-0">
        <input asp-for="Id" type="hidden" />
        <div class="card-body p-4">
            <partial name="_Forma" model="Model" />
            <button type="submit" class="btn btn-primary mt-4 px-4"><i class="bi bi-check-lg me-1"></i> Sačuvaj izmjene</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
