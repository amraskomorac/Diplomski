@model IEnumerable<Diplomski.Models.Servis>
@{
    ViewData["Title"] = "Servisi";
}

<div class="container py-5" style="max-width: 1100px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Servisi</h2>
            <p class="text-muted mb-0">Pregled evidentiranih servisa i održavanja vozila.</p>
        </div>
        <a asp-action="Dodaj" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Dodaj servis</a>
    </div>

    @if (TempData["Poruka"] is not null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Poruka"]</span>
        </div>
    }

    @if (Model.Any())
    {
        var kategorije = Model.Select(s => s.Tip).Distinct().OrderBy(t => t).ToList();
        var godine = Model.Select(s => s.Datum.Year).Distinct().OrderByDescending(g => g).ToList();
        var mjeseci = new[] { "Januar", "Februar", "Mart", "April", "Maj", "Juni", "Juli", "August", "Septembar", "Oktobar", "Novembar", "Decembar" };
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="row g-3" aria-label="Filtriranje servisa">
                    <div class="col-md-3">
                        <label for="servisKategorija" class="form-label mb-1">Kategorija</label>
                        <select id="servisKategorija" class="form-select">
                            <option value="svi">Sve kategorije</option>
                            @foreach (var kategorija in kategorije)
                            {
                                <option value="@kategorija">@kategorija</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="servisPretraga" class="form-label mb-1">Pretraga</label>
                        <input id="servisPretraga" type="search" class="form-control" placeholder="Naziv, kilometraža ili serviser" />
                    </div>
                    <div class="col-md-2">
                        <label for="servisGodina" class="form-label mb-1">Godina</label>
                        <select id="servisGodina" class="form-select">
                            <option value="">Sve godine</option>
                            @foreach (var godina in godine)
                            {
                                <option value="@godina">@godina</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="servisMjesec" class="form-label mb-1">Mjesec</label>
                        <select id="servisMjesec" class="form-select">
                            <option value="">Svi mjeseci</option>
                            @for (var i = 0; i < mjeseci.Length; i++)
                            {
                                var vrijednostMjeseca = (i + 1).ToString("D2");
                                <option value="@vrijednostMjeseca">@mjeseci[i]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="servisDatum" class="form-label mb-1">Datum</label>
                        <input id="servisDatum" type="date" class="form-control" title="Odaberite datum" />
                    </div>
                </div>
            </div>
        </div>
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Vozilo</th>
                            <th>Servis</th>
                            <th>Datum</th>
                            <th class="text-end">Kilometraža</th>
                            <th class="text-end">Cijena</th>
                            <th>Serviser</th>
                            <th class="text-center">Račun</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var servis in Model)
                        {
                            var tekstPretrage = $"{servis.Tip} {servis.Kilometraza} {servis.Serviser} {servis.Napomena}".ToLowerInvariant();
                            <tr data-service-category="@servis.Tip" data-service-search="@tekstPretrage" data-service-date="@servis.Datum.ToString("yyyy-MM-dd")">
                                <td>@(servis.Vozilo is null ? "Nije odabrano" : $"{servis.Vozilo.Marka} {servis.Vozilo.Model}")</td>
                                <td class="fw-semibold">@servis.Tip</td>
                                <td>@servis.Datum.ToString("dd.MM.yyyy.")</td>
                                <td class="text-end">@servis.Kilometraza.ToString("N0") km</td>
                                <td class="text-end">@servis.Cijena.ToString("N2") KM</td>
                                <td>@servis.Serviser</td>
                                <td class="text-center">
                                    @if (!string.IsNullOrWhiteSpace(servis.PutanjaRacuna))
                                    {
                                        <a href="@servis.PutanjaRacuna" target="_blank" class="btn btn-outline-primary btn-sm" title="Otvori račun" aria-label="Otvori račun">
                                            <i class="bi bi-receipt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Uredi" asp-route-id="@servis.Id" class="btn btn-outline-primary btn-sm" title="Uredi servis" aria-label="Uredi servis"><i class="bi bi-pencil-square"></i></a>
                                        <form asp-action="Obrisi" asp-route-id="@servis.Id" method="post">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Obriši servis" aria-label="Obriši servis" onclick="return confirm('Da li želite obrisati ovaj servis?');"><i class="bi bi-trash3"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-light border">Još nemate evidentiranih servisa. Kliknite „Dodaj servis“ za početak.</div>
    }
</div>

@section Scripts {
    <script>
        var kategorija = document.getElementById('servisKategorija');
        var pretraga = document.getElementById('servisPretraga');
        var godina = document.getElementById('servisGodina');
        var mjesec = document.getElementById('servisMjesec');
        var datum = document.getElementById('servisDatum');

        function filtrirajServise() {
            if (!kategorija || !pretraga || !godina || !mjesec || !datum) return;

            var odabranaKategorija = kategorija.value;
            var pojam = pretraga.value.trim().toLowerCase();
            var odabranaGodina = godina.value;
            var odabraniMjesec = mjesec.value;
            var odabraniDatum = datum.value;

            document.querySelectorAll('[data-service-category]').forEach(function (stavka) {
                var odgovaraKategoriji = odabranaKategorija === 'svi' || stavka.getAttribute('data-service-category') === odabranaKategorija;
                var odgovaraPretrazi = !pojam || (stavka.dataset.serviceSearch || '').includes(pojam);
                var datumStavke = stavka.dataset.serviceDate || '';
                var odgovaraDatumu = odabraniDatum
                    ? datumStavke === odabraniDatum
                    : (!odabranaGodina || datumStavke.startsWith(odabranaGodina + '-'))
                        && (!odabraniMjesec || datumStavke.slice(5, 7) === odabraniMjesec);

                stavka.hidden = !odgovaraKategoriji || !odgovaraPretrazi || !odgovaraDatumu;
            });
        }

        kategorija?.addEventListener('change', filtrirajServise);
        pretraga?.addEventListener('input', filtrirajServise);
        godina?.addEventListener('change', filtrirajServise);
        mjesec?.addEventListener('change', filtrirajServise);
        datum?.addEventListener('change', filtrirajServise);
    </script>
}
