@model IEnumerable<Diplomski.Models.Servis>
@{
    ViewData["Title"] = "Servisi";
}

<div class="container py-5" style="max-width: 1100px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Servisi</h2>
            <p class="text-muted mb-0">Pregled evidentiranih servisa i održavanja vozila.</p>
        </div>
        <a asp-action="Dodaj" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Dodaj servis</a>
    </div>

    @if (TempData["Poruka"] is not null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Poruka"]</span>
        </div>
    }

    @if (Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Vozilo</th>
                            <th>Servis</th>
                            <th>Datum</th>
                            <th class="text-end">Kilometraža</th>
                            <th class="text-end">Cijena</th>
                            <th>Serviser</th>
                            <th class="text-center">Račun</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var servis in Model)
                        {
                            <tr>
                                <td>@(servis.Vozilo is null ? "Nije odabrano" : $"{servis.Vozilo.Marka} {servis.Vozilo.Model}")</td>
                                <td class="fw-semibold">@servis.Tip</td>
                                <td>@servis.Datum.ToString("dd.MM.yyyy.")</td>
                                <td class="text-end">@servis.Kilometraza.ToString("N0") km</td>
                                <td class="text-end">@servis.Cijena.ToString("N2") KM</td>
                                <td>@servis.Serviser</td>
                                <td class="text-center">
                                    @if (!string.IsNullOrWhiteSpace(servis.PutanjaRacuna))
                                    {
                                        <a href="@servis.PutanjaRacuna" target="_blank" class="btn btn-outline-primary btn-sm" title="Otvori račun" aria-label="Otvori račun">
                                            <i class="bi bi-receipt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Uredi" asp-route-id="@servis.Id" class="btn btn-outline-primary btn-sm" title="Uredi servis" aria-label="Uredi servis"><i class="bi bi-pencil-square"></i></a>
                                        <form asp-action="Obrisi" asp-route-id="@servis.Id" method="post">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Obriši servis" aria-label="Obriši servis" onclick="return confirm('Da li želite obrisati ovaj servis?');"><i class="bi bi-trash3"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-light border">Još nemate evidentiranih servisa. Kliknite „Dodaj servis“ za početak.</div>
    }
</div>
