@model Diplomski.Models.DokumentiViewModel
@{
    ViewData["Title"] = "Dokumenti";
    var tipovi = new[]
    {
        (Tip: "Vozačka dozvola", Naziv: "Vozačka dozvola"),
        (Tip: "Saobraćajna", Naziv: "Saobraćajna dozvola"),
        (Tip: "Osiguranje", Naziv: "Polica osiguranja")
    };
}

<div class="container py-5" style="max-width: 960px">
    <div class="mb-4">
        <h2 class="mb-1">Dokumenti</h2>
    </div>

    @if (TempData["Poruka"] is not null)
    {
        <div class="alert alert-success">@TempData["Poruka"]</div>
    }
    @if (TempData["Greska"] is not null)
    {
        <div class="alert alert-danger">@TempData["Greska"]</div>
    }

    <div class="dokumenti-lista">
        @foreach (var stavka in tipovi)
        {
            var dokument = Model.Dokumenti.FirstOrDefault(d => d.Tip == stavka.Tip);
            var jeSlika = dokument is not null &&
                (dokument.Putanja.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                 dokument.Putanja.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                 dokument.Putanja.EndsWith(".png", StringComparison.OrdinalIgnoreCase));
            <div class="dokument-stavka">
                <label class="form-label" for="datoteka-@stavka.Tip.Replace(" ", "-")">@stavka.Naziv</label>
                @if (dokument is not null)
                {
                    <div class="spremljeni-dokument mb-3">
                        @if (jeSlika)
                        {
                            <a href="@dokument.Putanja" target="_blank" title="Otvori dokument u punoj veličini">
                                <img src="@dokument.Putanja" alt="@stavka.Naziv" class="pregled-dokumenta" />
                            </a>
                        }
                        else
                        {
                            <a href="@dokument.Putanja" target="_blank" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-file-earmark-pdf me-1"></i>Otvori spremljeni PDF
                            </a>
                        }
                        <div class="small text-muted mt-2">Spremljeno: @dokument.NazivDatoteke</div>
                    </div>
                }
                <form asp-action="Sacuvaj" method="post" enctype="multipart/form-data" class="dokument-upload">
                    <input type="hidden" name="tip" value="@stavka.Tip" />
                    <input id="datoteka-@stavka.Tip.Replace(" ", "-")" type="file" name="datoteka" class="form-control" accept=".jpg,.jpeg,.png,.pdf" required />
                    <button type="submit" class="btn btn-primary">Upload</button>
                </form>
            </div>
        }
    </div>
</div>
