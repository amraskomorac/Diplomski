@model Diplomski.Models.DokumentiViewModel
@{
    ViewData["Title"] = "Dokumenti";
    var tipovi = new[] { "Saobraćajna", "Osiguranje", "Račun", "Servisna knjižica" };
}

<div class="container py-5" style="max-width: 960px">
    <div class="mb-4">
        <h2 class="mb-1">Dokumenti</h2>
        <p class="text-muted mb-0">Sačuvajte važne dokumente i po potrebi ih zamijenite novom verzijom.</p>
    </div>

    @if (TempData["Poruka"] is not null)
    {
        <div class="alert alert-success">@TempData["Poruka"]</div>
    }
    @if (TempData["Greska"] is not null)
    {
        <div class="alert alert-danger">@TempData["Greska"]</div>
    }

    <div class="row g-4">
        @foreach (var tip in tipovi)
        {
            var dokument = Model.Dokumenti.FirstOrDefault(d => d.Tip == tip);
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100 dokument-kartica">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h3 class="h5 mb-1">@tip</h3>
                                @if (dokument is null)
                                {
                                    <span class="text-muted small">Dokument nije dodan</span>
                                }
                                else
                                {
                                    <a href="@dokument.Putanja" target="_blank" class="small text-decoration-none">@dokument.NazivDatoteke</a>
                                    <div class="text-muted small mt-1">Izmijenjen: @dokument.DatumIzmjene.ToLocalTime().ToString("dd.MM.yyyy.")</div>
                                }
                            </div>
                            @if (dokument is not null)
                            {
                                <form asp-action="Obrisi" asp-route-id="@dokument.Id" method="post">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Ukloni dokument" onclick="return confirm('Da li želite ukloniti ovaj dokument?');">Ukloni</button>
                                </form>
                            }
                        </div>
                        <form asp-action="Sacuvaj" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="tip" value="@tip" />
                            <div class="input-group">
                                <input type="file" name="datoteka" class="form-control" accept=".jpg,.jpeg,.png,.pdf" required />
                                <button type="submit" class="btn btn-primary">@(dokument is null ? "Upload" : "Zamijeni")</button>
                            </div>
                            <div class="form-text">JPG, PNG ili PDF, do 5 MB.</div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
