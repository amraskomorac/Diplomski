@model Diplomski.Models.Gorivo
@{ ViewData["Title"] = "Dodaj gorivo"; }
<div class="container py-5" style="max-width:650px"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Dodaj gorivo</h2><p class="text-muted mb-0">Evidentirajte tocenje goriva.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Historija goriva</a></div>
<form asp-action="Dodaj" method="post" class="card shadow-sm border-0"><div class="card-body p-4"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="VoziloId" class="form-label">Vozilo</label><select asp-for="VoziloId" asp-items="ViewBag.Vozila" class="form-select"><option value="">Odaberite vozilo</option></select><span asp-validation-for="VoziloId" class="text-danger"></span></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="Datum" class="form-label">Datum</label><input asp-for="Datum" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-6"><label asp-for="Kilometraza" class="form-label">Kilometraza</label><input asp-for="Kilometraza" type="number" min="0" class="form-control" /></div><div class="col-md-6"><label asp-for="Litara" class="form-label">Litara</label><input asp-for="Litara" type="number" min="0.01" step="0.01" class="form-control" /></div><div class="col-md-6"><label asp-for="Cijena" class="form-label">Cijena (KM)</label><input asp-for="Cijena" type="number" min="0.01" step="0.01" class="form-control" /></div></div><button class="btn btn-primary mt-4">Sacuvaj unos</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
