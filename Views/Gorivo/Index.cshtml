@model Diplomski.Models.GorivoIndexViewModel
@{ ViewData["Title"] = "Gorivo"; }
<div class="container py-5" style="max-width:1000px"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h2 class="mb-1">Gorivo</h2><p class="text-muted mb-0">Pracenje potrosnje i troskova goriva.</p></div><a asp-action="Dodaj" class="btn btn-primary">+ Dodaj gorivo</a></div>
@if (Model.Vozila.Any()) { <form method="get" class="mb-4"><select name="voziloId" class="form-select" style="max-width:360px" onchange="this.form.submit()">@foreach(var v in Model.Vozila){<option value="@v.Id" selected="@(v.Id == Model.VoziloId)">@v.Marka @v.Model</option>}</select></form> }
@if (TempData["Poruka"] != null) { <div class="alert alert-success">@TempData["Poruka"]</div> }
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card shadow-sm border-0 h-100"><div class="card-body"><div class="text-muted">Prosjecna potrosnja</div><div class="fs-4 fw-semibold">@(Model.ProsjecnaPotrosnja?.ToString("N2") ?? "-") L / 100 km</div></div></div></div><div class="col-md-4"><div class="card shadow-sm border-0 h-100"><div class="card-body"><div class="text-muted">Cijena po kilometru</div><div class="fs-4 fw-semibold">@(Model.CijenaPoKilometru?.ToString("N3") ?? "-") KM</div></div></div></div><div class="col-md-4"><div class="card shadow-sm border-0 h-100"><div class="card-body"><div class="text-muted">Ukupno potroseno gorivo</div><div class="fs-4 fw-semibold">@Model.UkupnoPotroseno.ToString("N2") KM</div></div></div></div></div>
@if(Model.Zapisi.Any()) { <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Datum</th><th>Kilometraza</th><th>Litara</th><th class="text-end">Cijena</th><th></th></tr></thead><tbody>@foreach(var g in Model.Zapisi){<tr><td>@g.Datum.ToString("dd.MM.yyyy.")</td><td>@g.Kilometraza.ToString("N0") km</td><td>@g.Litara.ToString("N2") L</td><td class="text-end">@g.Cijena.ToString("N2") KM</td><td><div class="d-flex justify-content-end gap-2"><a asp-action="Uredi" asp-route-id="@g.Id" class="btn btn-outline-primary btn-sm" title="Uredi"><i class="bi bi-pencil-square"></i></a><form asp-action="Obrisi" asp-route-id="@g.Id" method="post"><button class="btn btn-outline-danger btn-sm" onclick="return confirm('Da li zelite obrisati unos goriva?');" title="Obrisi"><i class="bi bi-trash3"></i></button></form></div></td></tr>}</tbody></table></div></div> } else { <div class="alert alert-light border">Jos nema evidentiranih unosa goriva. Za izracun prosjecne potrosnje potrebna su najmanje dva unosa.</div> }
</div>
