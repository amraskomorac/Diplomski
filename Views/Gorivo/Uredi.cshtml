@model Diplomski.Models.Gorivo
@{ ViewData["Title"] = "Uredi gorivo"; }
<div class="container py-5" style="max-width:650px"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Uredi unos goriva</h2><p class="text-muted mb-0">Izmijenite evidentirani unos.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Historija goriva</a></div>
<form asp-action="Uredi" asp-route-id="@Model.Id" method="post" class="card shadow-sm border-0"><div class="card-body p-4"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="VoziloId" class="form-label">Vozilo</label><select asp-for="VoziloId" asp-items="ViewBag.Vozila" class="form-select"></select><span asp-validation-for="VoziloId" class="text-danger"></span></div>
<partial name="_Polja" model="Model" /><button class="btn btn-primary mt-4">Sacuvaj izmjene</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
