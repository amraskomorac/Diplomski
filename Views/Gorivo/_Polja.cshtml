@model Diplomski.Models.Gorivo

<div class="row g-3">
    <div class="col-md-6"><label asp-for="Datum" class="form-label">Datum</label><input asp-for="Datum" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" /><span asp-validation-for="Datum" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Kilometraza" class="form-label">Kilometraža</label><input asp-for="Kilometraza" type="number" min="0" class="form-control" /><span asp-validation-for="Kilometraza" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Litara" class="form-label">Litara</label><input asp-for="Litara" type="number" min="0.01" step="0.01" class="form-control" /><span asp-validation-for="Litara" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Cijena" class="form-label">Cijena (KM)</label><input asp-for="Cijena" type="number" min="0.01" step="0.01" class="form-control" /><span asp-validation-for="Cijena" class="text-danger"></span></div>
</div>
