@model Diplomski.Models.DashboardViewModel
@{ ViewData["Title"] = "Pocetna stranica"; }

<div class="container py-5" style="max-width: 1000px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><h2 class="mb-1">Pocetna stranica</h2><p class="text-muted mb-0">Pregled vaseg vozila i odrzavanja.</p></div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#dokumentiModal">Dokumenti</button>
            @if (Model.OdabranoVozilo is not null)
            {
                <a asp-controller="Servisi" asp-action="Index" class="btn btn-primary"><i class="bi bi-tools me-2"></i>Servisi</a>
                @if (Model.Vozila.Count > 1)
                {
                    <a asp-action="Index" asp-route-promijeniVozilo="true" class="btn btn-outline-primary"><i class="bi bi-grid-3x3-gap me-2"></i>Promijeni vozilo</a>
                }
            }
        </div>
    </div>
    @if (TempData["Poruka"] is not null) { <div class="alert alert-success">@TempData["Poruka"]</div> }
    @if (TempData["Greska"] is not null) { <div class="alert alert-danger">@TempData["Greska"]</div> }
    @if (Model.OdabranoVozilo is null)
    {
        @if (!Model.Vozila.Any())
        {
            <div class="alert alert-light border">Jos nemate dodano vozilo. <a asp-controller="Vozila" asp-action="Dodaj">Dodajte prvo vozilo.</a></div>
        }
        else
        {
            <section class="vozila-izbor">
                <div class="row g-4">
                    @for (var i = 0; i < Model.Vozila.Count; i++)
                    {
                        var vozilo = Model.Vozila[i];
                        var varijanta = i % 4 + 1;
                        <div class="col-md-6">
                            <a asp-action="Index" asp-route-voziloId="@vozilo.Id" class="vozilo-izbor-kartica vozilo-varijanta-@varijanta">
                                <h3>@vozilo.Marka @vozilo.Model</h3>
                                <div class="vozilo-registracija">@vozilo.Registracija</div>
                            </a>
                        </div>
                    }
                </div>
            </section>
        }
    }
    else
    {
        @if (TempData["GreskaKilometraza"] is not null) { <div class="alert alert-danger">@TempData["GreskaKilometraza"]</div> }
        @if (TempData["PorukaKilometraza"] is not null) { <div class="alert alert-success">@TempData["PorukaKilometraza"]</div> }
        @if (TempData["GreskaRegistracija"] is not null) { <div class="alert alert-danger">@TempData["GreskaRegistracija"]</div> }
        @if (TempData["PorukaRegistracija"] is not null) { <div class="alert alert-success">@TempData["PorukaRegistracija"]</div> }
        <div class="card shadow-sm border-0 mb-4"><div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-2"><div><div class="text-muted small mb-1">Dashboard vozila</div><h3 class="mb-0">@Model.OdabranoVozilo.Marka @Model.OdabranoVozilo.Model</h3></div><span class="badge text-bg-light border fs-6">@Model.OdabranoVozilo.Registracija</span></div></div>
        <div class="row g-3 mb-4">
            <div class="col-md-6 col-lg-4"><div class="card h-100 shadow-sm border-0"><div class="card-body"><div class="text-muted">Trenutna kilometraza</div><div class="fs-4 fw-semibold mb-3">@Model.OdabranoVozilo.TrenutnaKilometraza.ToString("N0") km</div><button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#kilometrazaModal">Azuriraj</button></div></div></div>
            <div class="col-md-6 col-lg-4"><div class="card h-100 shadow-sm border-0"><div class="card-body"><div class="text-muted">Registracija</div><div class="fs-5 fw-semibold">Istice za @Model.DaniDoIstekaRegistracije dana<br /><small>@Model.DatumIstekaRegistracije.ToString("dd.MM.yyyy.")</small></div><button type="button" class="btn btn-outline-primary btn-sm mt-3" data-bs-toggle="modal" data-bs-target="#registracijaModal">Detalji</button></div></div></div>
            <div class="col-md-6 col-lg-4"><div class="card h-100 shadow-sm border-0"><div class="card-body"><div class="text-muted">Ukupni troskovi ove godine</div><div class="fs-4 fw-semibold">@Model.UkupniTrosakOveGodine.ToString("N2") KM</div></div></div></div>
            <div class="col-md-6"><div class="card h-100 shadow-sm border-0"><div class="card-body"><h5>Mali servis</h5><div class="text-muted">Posljednji mali servis</div><div class="fw-semibold mb-3">@Model.PosljednjiMaliServis</div><div class="text-muted">Sljedeci mali servis</div><div class="fs-5 fw-semibold">@Model.SljedeciMaliServis</div></div></div></div>
            <div class="col-md-6"><div class="card h-100 shadow-sm border-0"><div class="card-body"><h5>Veliki servis</h5><div class="text-muted">Posljednji veliki servis</div><div class="fw-semibold mb-3">@Model.PosljednjiVelikiServis</div><div class="text-muted">Sljedeci veliki servis</div><div class="fs-5 fw-semibold">@Model.SljedeciVelikiServis</div></div></div></div>
        </div>

        <section class="card shadow-sm border-0 podsjetnici-kartica"><div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><div><h4 class="mb-1">Podsjetnici</h4><p class="text-muted mb-0">Pracenje rokova za vase vozilo.</p></div>
                @if (Model.AktivneObavijesti.Any()) { <span class="badge text-bg-warning">@Model.AktivneObavijesti.Count aktivno</span> }
            </div>
            @if (Model.AktivneObavijesti.Any())
            {
                <div class="row g-3">
                    @foreach (var podsjetnik in Model.AktivneObavijesti)
                    {
                        var stanje = podsjetnik.JeHitno ? "podsjetnik-hitno" : "podsjetnik-uskoro";
                        <div class="col-md-6"><article class="podsjetnik @stanje"><div class="podsjetnik-ikona"><i class="bi @podsjetnik.Ikona"></i></div><div class="flex-grow-1"><h5 class="mb-3">@podsjetnik.Naziv</h5><dl class="podsjetnik-detalji mb-3"><div><dt>Zadnji put</dt><dd>@podsjetnik.ZadnjiPut</dd></div><div><dt>Interval</dt><dd>@podsjetnik.Interval</dd></div><div><dt>Trenutno</dt><dd>@podsjetnik.Trenutno</dd></div></dl><p class="mb-0 fw-semibold @(podsjetnik.JeHitno ? "text-danger" : "text-warning-emphasis")">@podsjetnik.Status</p></div></article></div>
                    }
                </div>
            }
            else
            {
                <p class="mb-0 text-success"><i class="bi bi-check-circle me-2"></i>Nema podsjetnika koji zahtijevaju paznju.</p>
            }
        </div></section>
    }
</div>

@{
    var tipoviDokumenata = new[]
    {
        (Tip: "Vozačka dozvola", Naziv: "Vozačka dozvola"),
        (Tip: "Saobraćajna", Naziv: "Saobraćajna dozvola"),
        (Tip: "Osiguranje", Naziv: "Polica osiguranja")
    };
    var povratakNaDashboard = Url.Action("Index", "Dashboard", new { voziloId = Model.OdabranoVozilo?.Id });
}
<div class="modal fade" id="dokumentiModal" tabindex="-1" aria-labelledby="dokumentiModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <div><h5 class="modal-title" id="dokumentiModalLabel">Dokumenti</h5><p class="text-muted small mb-0">Uploadujte ili zamijenite svoje dokumente.</p></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button>
            </div>
            <div class="modal-body p-4">
                <div class="dokumenti-lista">
                    @foreach (var stavka in tipoviDokumenata)
                    {
                        <div class="dokument-stavka">
                            <label class="form-label" for="dashboard-datoteka-@stavka.Tip.Replace(" ", "-")">@stavka.Naziv</label>
                            <form asp-controller="Dokumenti" asp-action="Sacuvaj" method="post" enctype="multipart/form-data" class="dokument-upload">
                                <input type="hidden" name="tip" value="@stavka.Tip" />
                                <input type="hidden" name="povratak" value="@povratakNaDashboard" />
                                <input id="dashboard-datoteka-@stavka.Tip.Replace(" ", "-")" type="file" name="datoteka" class="form-control" accept=".jpg,.jpeg,.png,.pdf" required />
                                <button type="submit" class="btn btn-primary">Upload</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Zatvori</button></div>
        </div>
    </div>
</div>

@if (Model.OdabranoVozilo is not null)
{
    <div class="modal fade" id="kilometrazaModal" tabindex="-1" aria-labelledby="kilometrazaModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form asp-action="AzurirajKilometrazu" method="post" class="modal-content"><div class="modal-header"><h5 class="modal-title" id="kilometrazaModalLabel">Azuriraj kilometrazu</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button></div><div class="modal-body"><input type="hidden" name="voziloId" value="@Model.OdabranoVozilo.Id" /><label for="kilometraza" class="form-label">Nova kilometraza</label><div class="input-group"><input id="kilometraza" name="kilometraza" type="number" min="@Model.OdabranoVozilo.TrenutnaKilometraza" value="@Model.OdabranoVozilo.TrenutnaKilometraza" class="form-control" required /><span class="input-group-text">km</span></div><div class="form-text">Nova kilometraza ne moze biti manja od @Model.OdabranoVozilo.TrenutnaKilometraza.ToString("N0") km.</div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Odustani</button><button type="submit" class="btn btn-primary">Sacuvaj</button></div></form></div></div>
    <div class="modal fade" id="registracijaModal" tabindex="-1" aria-labelledby="registracijaModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><form asp-action="AzurirajRegistraciju" method="post" class="modal-content"><div class="modal-header"><h5 class="modal-title" id="registracijaModalLabel">Detalji registracije</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button></div><div class="modal-body"><input type="hidden" name="VoziloId" value="@Model.OdabranoVozilo.Id" /><div class="mb-3"><label for="datumRegistracije" class="form-label">Datum registracije</label><input id="datumRegistracije" name="DatumRegistracije" type="date" value="@Model.OdabranoVozilo.DatumRegistracije.ToString("yyyy-MM-dd")" class="form-control" required /></div><div class="mb-3"><label for="datumIstekaRegistracije" class="form-label">Datum isteka</label><input id="datumIstekaRegistracije" name="DatumIstekaRegistracije" type="date" value="@Model.DatumIstekaRegistracije.ToString("yyyy-MM-dd")" class="form-control" required /></div><div class="mb-3"><label for="cijenaRegistracije" class="form-label">Cijena (KM)</label><input id="cijenaRegistracije" name="Cijena" type="number" min="0.01" max="99999999.99" step="0.01" value="@Model.OdabranoVozilo.CijenaRegistracije?.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required /></div><div><label for="policaOsiguranja" class="form-label">Polica osiguranja</label><input id="policaOsiguranja" name="PolicaOsiguranja" value="@Model.OdabranoVozilo.PolicaOsiguranja" maxlength="150" class="form-control" required /></div><hr class="my-4" /><h6>Prethodne registracije</h6>@if (Model.HistorijaRegistracija.Any()) { <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Registracija</th><th>Ističe</th><th class="text-end">Cijena</th><th>Polica</th></tr></thead><tbody>@foreach (var registracija in Model.HistorijaRegistracija) { <tr><td>@registracija.DatumRegistracije.ToString("dd.MM.yyyy.")</td><td>@registracija.DatumIstekaRegistracije.ToString("dd.MM.yyyy.")</td><td class="text-end">@(registracija.Cijena?.ToString("N2") ?? "—") KM</td><td>@(string.IsNullOrWhiteSpace(registracija.PolicaOsiguranja) ? "—" : registracija.PolicaOsiguranja)</td></tr> }</tbody></table></div> } else { <p class="text-muted mb-0">Nema evidentiranih prethodnih registracija.</p> }</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Odustani</button><button type="submit" class="btn btn-primary">Sačuvaj detalje</button></div></form></div></div>
}

@if (Model.PrikaziObavijesti)
{
    <div class="modal fade" id="obavijestiModal" tabindex="-1" aria-labelledby="obavijestiModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow"><div class="modal-header"><h5 class="modal-title" id="obavijestiModalLabel"><i class="bi bi-bell-fill me-2"></i>Obavijesti za vozilo</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button></div><div class="modal-body">@foreach (var obavijest in Model.AktivneObavijesti) { <div class="d-flex gap-2 mb-3"><i class="bi bi-bell text-warning"></i><div><strong>@obavijest.Naziv</strong><br /><span class="text-muted">@obavijest.Status</span></div></div> }</div><div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">U redu</button></div></div></div></div>
}

@section Scripts {
    @if (Model.PrikaziObavijesti)
    { <script>document.addEventListener('DOMContentLoaded', function () { new bootstrap.Modal(document.getElementById('obavijestiModal')).show(); });</script> }
    @if (TempData["PrikaziDokumente"] is not null)
    { <script>document.addEventListener('DOMContentLoaded', function () { new bootstrap.Modal(document.getElementById('dokumentiModal')).show(); });</script> }
}
