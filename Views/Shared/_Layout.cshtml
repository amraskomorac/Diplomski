<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MojeAuto</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
    <script>
        if (localStorage.getItem('tema-prikaza') === 'tamna') {
            document.documentElement.classList.add('tamni-rezim');
        }
    </script>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="navbar navbar-expand-lg navbar-dark autocare-zaglavlje">
            <div class="container">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">MojeAuto</a>
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Početna</a>
                    <a class="nav-link" asp-controller="Vozila" asp-action="Index">Vozila</a>
                    <a class="nav-link" asp-controller="Gorivo" asp-action="Index">Gorivo</a>
                    <a class="nav-link" asp-controller="Statistika" asp-action="Index">Statistika</a>
                    <a class="nav-link" asp-controller="Profil" asp-action="Index">Profil</a>
                    <form asp-controller="Auth" asp-action="Odjava" method="post" class="d-flex">
                        <button type="submit" class="nav-link border-0 bg-transparent">Odjava</button>
                    </form>
                </div>
            </div>
        </nav>
    }
    <main>
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
